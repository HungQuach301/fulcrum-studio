{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sources.schema.json",
  "title": "Research Sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["episodeId", "claims", "counterClaims"],
  "properties": {
    "episodeId": { "type": "string" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "statement", "origin"],
        "properties": {
          "claimId": { "type": "string", "pattern": "^C-[0-9]{3}$" },
          "statement": { "type": "string" },
          "value": { "type": ["number", "string"] },
          "unit": { "type": "string" },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "enum": ["snapshot", "model", "url"], "description": "Trường bắt buộc kèm theo: snapshot -> snapshotKey; model -> modelId, modelVersion, inputSetId, outputKey; url -> url. Quan hệ này được kiểm bằng if/then draft-07 và validator tầng 2; xem D-19." },
              "snapshotKey": { "type": "string" },
              "modelId": { "type": "string" },
              "modelVersion": { "type": "string" },
              "inputSetId": { "type": "string" },
              "outputKey": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "asOfDate": { "type": "string", "format": "date" }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "snapshot"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "snapshotKey"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "model"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "modelId",
                    "modelVersion",
                    "inputSetId",
                    "outputKey"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "url"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "url"
                  ]
                }
              }
            ]
          },
          "geoLevel": { "type": "string", "enum": ["national", "state", "metro", "county"] }
        }
      }
    },
    "counterClaims": {
      "type": "array",
      "minItems": 1,
      "description": "Ít nhất 2 claim phản bác thesis. Nghiên cứu một chiều là fail.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "statement"],
        "properties": {
          "claimId": { "type": "string", "pattern": "^C-[0-9]{3}$" },
          "statement": { "type": "string" }
        }
      }
    },
    "costUsd": { "type": "number", "minimum": 0 },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Tuỳ chọn. Không khai thì kế thừa qua episodeId từ brief và episode-state; xem D-19.",
      "required": [
        "engine",
        "genre",
        "channel"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "genre": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        }
      }
    }
  }
}
