{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "publish-allowlist.schema.json",
  "title": "Publication Path Allowlist",
  "description": "Cấu trúc danh sách đường dẫn được phép xuất. Giá trị chính sách nằm trong config/publish-allowlist.json; kiểm schema không chứng minh quyền tài khoản hoặc việc thực thi chính sách xuất. Xem D-16 và D-21.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "targetRepo",
    "allow",
    "deny",
    "requireCalculatorParity"
  ],
  "properties": {
    "note": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "targetRepo": {
      "type": "string"
    },
    "allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requireCalculatorParity": {
      "type": "boolean"
    }
  }
}
